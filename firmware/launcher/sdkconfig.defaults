CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# CYD App Platform layout: launcher in factory, apps in ota_0 (see docs/adr/0002).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Keep the launcher small so it fits the 1.25 MB factory partition.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_NEWLIB_NANO_FORMAT=y
# Trust only the common CA roots (covers github.com and its asset CDN).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# The update runs TLS, the HTTP client, flash writes, and screen redraws on the
# main task; the default 3.5 KB stack overflows during the download.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# FAT long file names for app folders on the SD card.
CONFIG_FATFS_LFN_HEAP=y
